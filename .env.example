# BlackSmith — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URL (preferred):
DATABASE_URL=postgresql://username:password@localhost:5432/blacksmith

# Alternatively, supply individual components (used if DATABASE_URL is absent):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=blacksmith
# DB_USER=username
# DB_PASSWORD=password

# ─── Groq API ─────────────────────────────────────────────────────────────────
# Your Groq API key (starts with gsk_):
GROQ_API_KEY=gsk_your_api_key_here

# Groq model to use for the support agent.
# Must support tool/function calling.
# Recommended: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Application Settings ─────────────────────────────────────────────────────
# Set to "true" to allow the seed command to insert sample data on first run.
# Seeding is never automatic; it only runs when explicitly requested.
ALLOW_SEED=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum number of tool-call iterations per workflow run (prevents loops).
MAX_TOOL_ITERATIONS=10

# ─── Development / Evaluation ─────────────────────────────────────────────────
# Set to "true" to print additional diagnostic output during graph execution.
DEBUG_GRAPH=false
